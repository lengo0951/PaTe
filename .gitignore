# PasteFlow .gitignore

# macOS system files
.DS_Store
*.swp
*~

# Swift & Build outputs
build/
dist/
target/
windows/target/
*.dmg
*.app
.build/
*.o

# AI Plans & Task Scratchpads
plans/
*.plan.md

# Package & Release Notes metadata
package.json
RELEASE_NOTES_*.md

# QuocNgoKit local private toolkit & runtime (Keep private)
.agents/
.claude/
.codex/
.ck.json
.env*
docs/
AGENTS.md
GEMINI.md
RULES.md
INSTALL.txt
guide/
papers/
scripts/
qn

# Explicitly track essential PasteFlow assets
!Assets/
!Assets/**
